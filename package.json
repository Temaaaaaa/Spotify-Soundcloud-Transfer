{
  "name": "spotify-soundcloud-migrator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write \"server/**/*.ts\" \"src/**/*.{ts,tsx,css}\" \"shared/**/*.ts\" \"tests/**/*.ts\" vite.config.ts",
    "format:check": "prettier --check \"server/**/*.ts\" \"src/**/*.{ts,tsx,css}\" \"shared/**/*.ts\" \"tests/**/*.ts\" vite.config.ts",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prettier": "3.9.8",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
